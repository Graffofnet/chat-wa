# Если на виртуальном хостинге приложение Node.js проксируется через Apache,
# раскомментируйте строки ниже (подставьте свой порт из панели хостинга):
#
# RewriteEngine On
# RewriteCond %{REQUEST_URI} ^/socket.io/ [OR]
# RewriteCond %{QUERY_STRING} transport=websocket
# RewriteRule ^(.*)$ http://127.0.0.1:3000/$1 [P,L]
